<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/chat_item_bg"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"

    android:padding="14dp">

    <!-- Avatar / Icon -->
    <ImageView
        android:id="@+id/chatAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:src="@drawable/mood_24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:backgroundTint="@color/white_100"
        android:layout_marginEnd="8dp" />

    <!-- Message & Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type a message..."
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:background="@drawable/bg_message_input"
            android:padding="12dp"
            android:inputType="text" />

    </LinearLayout>

    <!-- Timestamp -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/send_message_bg"
        android:padding="8dp"
        android:layout_gravity="center">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/send_24dp"/>
    </FrameLayout>

</LinearLayout>
